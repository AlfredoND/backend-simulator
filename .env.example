# Server / Servidor
HOST=127.0.0.1
PORT=4000
HTTPS_ENABLED=true
HTTPS_PORT=4443
HTTP2_ENABLED=true
HTTP2_PORT=4444
PROXY_ENABLED=false
PROXY_PORT=8080

# Web UI / Interfaz web
UI_ENABLED=true
UI_DIR=./web

# Database / Base de datos
DB_PATH=./data/backend-simulator.sqlite
SEED_SCALE=1

# Limits / Límites
MAX_BODY_BYTES=10485760
MAX_RESPONSE_BYTES=20971520
MAX_PAGE_SIZE=100
MAX_DELAY_MS=60000
REQUEST_TIMEOUT_MS=30000

# Local credentials / Credenciales locales
ADMIN_EMAIL=admin@simulator.local
ADMIN_PASSWORD=Admin123!
SEED_PASSWORD=Password123!
ADMIN_TOKEN=local-admin-token
VIEWER_TOKEN=local-viewer-token
TEST_API_KEY=local-test-api-key
CONTROL_TOKEN=local-control-token
BASIC_USER=testuser
BASIC_PASSWORD=testpass

# TLS / TLS
TLS_CERT_PATH=./certs/localhost-cert.pem
TLS_KEY_PATH=./certs/localhost-key.pem
TLS_AUTO_GENERATE=true

# Logs / Registros: debug | info | warn | error | silent
LOG_LEVEL=info
