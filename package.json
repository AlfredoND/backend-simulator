{
  "name": "backend-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local HTTP backend simulator with business APIs and an HTTP transport laboratory",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:dist": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "certs": "tsx scripts/gen-certs.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
