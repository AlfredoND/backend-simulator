{
  "name": "mafetch-backend-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Entorno local de simulación de APIs y transporte HTTP para probar Mafetch",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:dist": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json && cp src/schema.sql dist/src/schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "certs": "tsx scripts/gen-certs.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
